# 墨小小后端环境变量模板（部署脚本会自动生成真实 .env.local，此处仅作说明）
# 文件位置：仓库根目录 /.env.local （model_gateway.py 读取此处）

# 数据库连接（SQLite 文件）
DATABASE_URL=sqlite+pysqlite:////opt/moxx/apps/api/personal_writing_agent_mvp1.db

# 鉴权密钥（务必改成随机串，可用: openssl rand -hex 32）
AUTH_SECRET=change-me-to-random-hex

# 模型网关
MODEL_GATEWAY_MODE=auto            # auto / qwen / mock
DASHSCOPE_API_KEY=sk-xxxx          # 通义千问 key（国内模型，优先）
OPENAI_API_KEY=sk-xxxx             # 备选：OpenAI 兼容
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus               # 默认模型
REQUEST_TIMEOUT_SECONDS=120
